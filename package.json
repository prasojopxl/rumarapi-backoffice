{
    "name": "typecms-monorepo",
    "private": true,
    "version": "0.0.1",
    "workspaces": [
        "backend",
        "frontend"
    ],
    "scripts": {
        "dev": "npm run dev:be & npm run dev:fe",
        "dev:be": "npm run -w backend dev",
        "dev:fe": "npm run -w frontend dev",
        "build": "npm run build:be && npm run build:fe",
        "build:be": "npm run -w backend build",
        "build:fe": "npm run -w frontend build",
        "start:be": "npm run -w backend start",
        "preview:fe": "npm run -w frontend preview"
    }
}
