// --- CONFIGURATION ---
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// --- 1. USER & ROLE MANAGEMENT ---
model Role {
  id        String   @id @default(uuid())
  name      String   @unique // admin, manager, user
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model User {
  id           String   @id @default(uuid())
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  userName     String   @unique
  fullName     String
  email        String   @unique
  password     String
  posts        Post[]
  clientOrders Order[]  @relation("ClientOrders")
  workerOrders Order[]  @relation("WorkerOrders")
  changedOrderHistories OrderStatusHistory[] @relation("OrderStatusChangedByUser")
  status       String   @default("draft")
  apiTokens    ApiToken[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model ApiToken {
  id         String   @id @default(uuid())
  name       String?
  scopes     Json
  expiresAt  DateTime?
  isActive   Boolean  @default(true)
  createdBy  String?
  creator    User?    @relation(fields: [createdBy], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

// --- 2. MEDIA MANAGEMENT ---
model Media {
  id        String    @id @default(uuid())
  filename  String
  filePath  String
  fileType  String?
  fileSize  Int?
  // Relation back
  posts     Post[]    @relation("PostFeaturedImage")
  products  Product[] @relation("ProductThumbnail")
  banners   Banner[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
}

// --- 3. TAXONOMY (CATEGORIES & TAGS) ---
model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model Tag {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  taggables Taggable[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
}

model Taggable {
  id            String   @id @default(uuid())
  tagId         String
  tag           Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  relatableId   String // ID from Post or Product
  relatableType String // "POST" or "PRODUCT"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([tagId, relatableId, relatableType])
}

// --- 4. CONTENT (POSTS & PRODUCTS) ---
model Post {
  id              String   @id @default(uuid())
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  featuredImageId String?
  featuredImage   Media?   @relation("PostFeaturedImage", fields: [featuredImageId], references: [id])
  title           String
  slug            String   @unique
  content         String   @db.LongText
  type            String   @default("blog")
  status          String   @default("draft")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model Product {
  id          String    @id @default(uuid())
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  thumbnailId String?
  thumbnail   Media?    @relation("ProductThumbnail", fields: [thumbnailId], references: [id])
  name        String
  slug        String    @unique
  description String?   @db.Text
  price       Decimal   @db.Decimal(12, 2)
  stock       Int       @default(0)
  status      String    @default("draft")
  orderItems  OrderItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

// --- 5. ORDERS ---
enum OrderStatus {
  DRAFT
  PENDING
  CANCEL
  REJECT
  EXPIRED
  PROCESS
  ON_PROGRESS
  DONE
}

model Order {
  id          String      @id @default(uuid())
  bookingCode String      @unique
  clientId    String
  workerId    String?
  status      OrderStatus @default(DRAFT)
  scheduledAt DateTime?
  address     String
  note        String?
  items       OrderItem[]
  histories   OrderStatusHistory[]
  client      User        @relation("ClientOrders", fields: [clientId], references: [id])
  worker      User?       @relation("WorkerOrders", fields: [workerId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([clientId])
  @@index([workerId])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  productName String
  quantity    Int      @default(1)
  price       Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  startTime   DateTime?
  endTime     DateTime?
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id              String      @id @default(uuid())
  orderId         String
  fromStatus      OrderStatus
  toStatus        OrderStatus
  changedByUserId String
  note            String?
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser   User        @relation("OrderStatusChangedByUser", fields: [changedByUserId], references: [id])
  createdAt       DateTime    @default(now())

  @@index([orderId])
  @@index([changedByUserId])
}

// --- 6. BANNERS ---
model BannerPosition {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  banners   Banner[]
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Banner {
  id            String         @id @default(uuid())
  positionId    String
  position      BannerPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  mediaId       String?
  media         Media?         @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  title         String?
  subTitle      String?
  linkUrl       String?
  orderPriority Int            @default(0)
  isActive      Boolean        @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
}

// --- 7. SETTINGS ---
model Setting {
  key      String @id // Not use uuid because this is a unique identifier (example: 'site_name')
  value    String @db.Text
  siteName String?
}
